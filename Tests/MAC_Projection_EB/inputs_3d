n_cell = 128                             # number of cells in y-direction; we double this in the x-direction and divide by 8 in the z-direction
max_grid_size = 64                       # the maximum number of cells in any direction in a single grid (default: 32)

obstacles = 0 1 2 3 4 5 6 7 8            # this is how we choose which obstacles to include

#The parameters below specify solver choices

use_hypre = 0                            # if 1 then use hypre instead of geometric multigrid      (default: 0)

mg_verbose = 2                           # specify verbosity of geometric multigrid solver         (default: 0)
bottom_verbose = 2                       # specify verbosity of the bottom solver                  (default: 0)

regtest    = 0                           # If regtest == 1 then we don't plot zvel (used for regression testing with GPUs)

reltol = 1.e-8                           # Define the relative tolerance

abstol = 1.e-15                          # Define the absolute tolerance (optional)

# With AMReX built with HYPRE: project again with the composite solver
# (mac_proj.use_mlhypre) and compare with the MLMG projection, then
# mlhypre_num_solves projections in all with beta scaled by 2 each time
mlhypre_check = 0
mlhypre_num_solves = 3
mlhypre_max_diff = 1.e-6                 # both solves are converged to reltol
mac_proj.mlhypre_reuse_setup = 1              # keep the solver setup when beta changes
hypre_mlabeclap.hypre_solver = FlexGMRES      # the EB operator needs HypreMLABecLap's IJ mode
hypre_mlabeclap.hypre_preconditioner = BoomerAMG
