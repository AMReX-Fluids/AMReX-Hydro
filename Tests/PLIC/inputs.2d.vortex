# Circle in the time-reversed single vortex (Rider & Kothe), with AMR. Maximum stretching at
# t = period/2, back to a circle at t = period.
test.kind = advect

geometry.is_periodic = 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 1.0

amr.n_cell          = 64 64
amr.max_level       = 2
amr.ref_ratio       = 2 2
amr.regrid_int      = 4
amr.n_error_buf     = 2 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 64

prob.type   = vortex
prob.center = 0.5 0.75
prob.radius = 0.15
prob.period = 4.0

# The velocity passes through zero at t = period/2: use a fixed time step, with Courant number 0.5
# at the peak speed (1) on the finest level (dx = 1/256)
amr.fixed_dt  = 0.001953125
amr.stop_time = 4.0

test.max_l1            = 5.0e-4
test.max_volume_change = 1.0e-13
test.max_f_excursion   = 1.0e-9
