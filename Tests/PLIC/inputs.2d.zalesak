# Zalesak's slotted disk, one solid-body revolution, with AMR.
test.kind = advect

geometry.is_periodic = 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 1.0

amr.n_cell          = 64 64
amr.max_level       = 2
amr.ref_ratio       = 2 2
amr.regrid_int      = 4
amr.n_error_buf     = 2 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 64

prob.type        = zalesak
prob.center      = 0.5 0.75
prob.radius      = 0.15
prob.slot_width  = 0.05
prob.slot_length = 0.25
prob.period      = 1.0

amr.cfl       = 0.45
amr.stop_time = 1.0

test.max_l1            = 1.0e-3
test.max_volume_change = 1.0e-13
test.max_f_excursion   = 1.0e-9
