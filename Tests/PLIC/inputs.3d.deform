# Sphere in LeVeque's deformation field, with AMR.
test.kind = advect

geometry.is_periodic = 1 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 1.0 1.0 1.0

amr.n_cell          = 32 32 32
amr.max_level       = 2
amr.ref_ratio       = 2 2
amr.regrid_int      = 4
amr.n_error_buf     = 2 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 32

prob.type   = vortex
prob.center = 0.35 0.35 0.35
prob.radius = 0.15
prob.period = 3.0

amr.fixed_dt  = 0.001953125
amr.stop_time = 3.0

test.max_volume_change = 1.0e-13
test.max_f_excursion   = 1.0e-9
