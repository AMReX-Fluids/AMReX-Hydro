@PACKAGE_INIT@

set(HYDRO_SPACEDIM @HYDRO_SPACEDIM@)
set(HYDRO_EB @HYDRO_EB@)
set(HYDRO_MPI @HYDRO_MPI@)
set(HYDRO_OMP @HYDRO_OMP@)
set(HYDRO_GPU_BACKEND @HYDRO_GPU_BACKEND@)

# These must be resolved before find_package(AMReX), because on CMake < 3.30
# AMReX's own package-init block overwrites PACKAGE_PREFIX_DIR with AMReX's prefix.
set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(@PROJECT_NAME@_LIBRARY_DIRS "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

find_package(AMReX QUIET REQUIRED @AMREX_REQUIRED_COMPONENTS@)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

set(@PROJECT_NAME@_LIBRARIES "@PROJECT_NAME@::amrex_hydro_api")

set(@PROJECT_NAME@_FOUND TRUE)
check_required_components(@PROJECT_NAME@)
